  "nodes.warsztat.options.[wyjscie].text": {"t":"Another time.","h":"539d11b8"},
  "nodes.warsztat.speaker": {"t":"Brygida the Handywoman","h":"6a61497a"},
  "nodes.warsztat.text": {"t":"Brygida crawls out from under a sheet of metal, spanner in hand. \"Let me guess. Something about the way it works doesn't suit you. Show me. But it'll cost you. Grease and time don't come from nowhere.\"","h":"33005d48"},
  "nodes.za_ciezko.options.[dalej].text": {"t":"Right, I'll make room.","h":"9df60025"},
  "nodes.za_ciezko.speaker": {"t":"Brygida the Handywoman","h":"6a61497a"},
  "nodes.za_ciezko.text": {"t":"Brygida hefts your bag and sets it straight back down. \"I couldn't fit another screw in there. Throw out some scrap and come back.\"","h":"b134e81d"},
  "nodes.zrobione.options.[dalej].text": {"t":"Right.","h":"a8072584"},
  "nodes.zrobione.speaker": {"t":"Brygida the Handywoman","h":"6a61497a"},
  "nodes.zrobione.text": {"t":"Brygida shoves it into your hands. \"Done. Take it and don't come back till it breaks. And when it breaks, it's not my fault.\"","h":"6a03d3b4"},
  "nodes.zrobione_belty.options.[dalej].text": {"t":"Right.","h":"a8072584"},
  "nodes.zrobione_belty.speaker": {"t":"Brygida the Handywoman","h":"6a61497a"},
  "nodes.zrobione_belty.text": {"t":"Brygida counts the bolts out on the bench and sweeps them over to you with her spanner. \"Ten. If one cracks, blame your crossbow, not me.\"","h":"3373ee8a"},
  "nodes.zrobione_pancerz.options.[dalej].text": {"t":"Right.","h":"a8072584"},
  "nodes.zrobione_pancerz.speaker": {"t":"Brygida the Handywoman","h":"6a61497a"},
  "nodes.zrobione_pancerz.text": {"t":"Brygida shoves it into your hands. \"Done. Put it on and don't come back till it breaks. And when it breaks, it's not my fault.\"","h":"c4906d6d"}
}
