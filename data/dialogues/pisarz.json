    "meld_stolica_przemyt_przejety": {
      "speaker": "Pisarz Atrament",
      "text": "„Przejął pan część? Nie zapytam o szczegóły. Uczciwość nie jest mocną stroną tego miasta, więc rozumiem.” Pisarz podsuwa ci kwit.",
