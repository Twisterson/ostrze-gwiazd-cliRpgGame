    "zlecenia": {
      "speaker": "Pisarz Atrament",
      "text": "„Tablica wisi tam, gdzie wisi. Brać z niej może każdy, kto umie czytać albo udaje. Po zrobieniu przychodzi pan do mnie, ja stempluję, ktoś płaci. W międzyczasie nikt nie zadaje pytań, bo pytania są drogie. Reklamacje przyjmuję we wtorki. Wtorków u nas nie ma.”",
      "options": [
        {
          "id": "dalej",
          "text": "Rozumiem.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_pozar_zgloszony": {
      "speaker": "Pisarz Atrament",
      "text": "„Zgłosił pan sprawę? Czyli sprawiedliwość miała dziś dobry dzień. Ciekawe, kto jej to zaplanował.” Pisarz notuje coś, czego nie pokazuje.",
      "actions": [
        {
          "setFlag": "kto_pali_w_zaulku_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_pozar_ukryty": {
      "speaker": "Pisarz Atrament",
      "text": "„Puścił pan dzieciaka? Szlachetnie. I nierozsądnie, ale szlachetne zapisuje się szybciej.” Pisarz stempluje bez entuzjazmu.",
      "actions": [
        {
          "setFlag": "kto_pali_w_zaulku_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_pozar_szantaz": {
      "speaker": "Pisarz Atrament",
      "text": "„Zarobił pan na tym? Szacunek. Sam bym tak zrobił, gdybym miał ładniejszy płaszcz.” Pisarz podsuwa ci pokwitowanie.",
      "actions": [
        {
          "setFlag": "kto_pali_w_zaulku_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_skarbnik_wydany": {
      "speaker": "Pisarz Atrament",
      "text": "„Wydał go pan? Ciężka sprawa. Ale pieniądze wróciły do skrzyni, a to ten rodzaj dobrej wiadomości, który nikogo nie cieszy.” Pisarz zamyka księgę.",
      "actions": [
        {
          "setFlag": "zaginiony_skarbnik_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_skarbnik_ukryty": {
      "speaker": "Pisarz Atrament",
      "text": "„Ukrył pan człowieka? Cóż, pieniądze gdzieś są, więc księga się zgadza. Nie widzę tu żadnej sprzeczności.” Pisarz stempluje i nie pyta.",
      "actions": [
        {
          "setFlag": "zaginiony_skarbnik_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_skarbnik_polowa": {
      "speaker": "Pisarz Atrament",
      "text": "„Po połowie? Po ludzku. Szkoda, że tu liczy się nie po ludzku, tylko po kwitach.” Pisarz uśmiecha się półgębkiem.",
      "actions": [
        {
          "setFlag": "zaginiony_skarbnik_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_wino_przemyt": {
      "speaker": "Pisarz Atrament",
      "text": "„Przemyt? Wspaniale. W tym mieście wszystko, co dobre, przychodzi bokiem.” Pisarz przybija pieczątkę z lekkim uśmiechem.",
      "actions": [
        {
          "setFlag": "wino_dla_koszar_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_wino_kupione": {
      "speaker": "Pisarz Atrament",
      "text": "„Kupił pan uczciwie? To dziwne, ale zapiszę bez komentarza.” Pisarz zerka na ciebie podejrzliwie.",
      "actions": [
        {
          "setFlag": "wino_dla_koszar_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_wino_nic": {
      "speaker": "Pisarz Atrament",
      "text": "„Powiedział pan, że wina nie będzie? Marszałek się ucieszy. Nie, żartuję: marszałek pana znienawidzi.” Pisarz wzdycha. „Trudno, przynajmniej to coś nowego.”",
      "actions": [
        {
          "setFlag": "wino_dla_koszar_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_dlug_splacony": {
      "speaker": "Pisarz Atrament",
      "text": "„Spłacił pan z własnych? Człowieku, tu się tak nie robi.” Pisarz kręci głową z podziwem. „Ale zapiszę jako dar na cele miłosierne.”",
      "actions": [
        {
          "setFlag": "dlug_przekupki_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_dlug_zastraszony": {
      "speaker": "Pisarz Atrament",
      "text": "„Zastraszył pan? Skutecznie. I taniej niż wynajęcie rajcy.” Pisarz stempluje, nie patrząc ci w oczy.",
      "actions": [
        {
          "setFlag": "dlug_przekupki_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_dlug_umorzony": {
      "speaker": "Pisarz Atrament",
      "text": "„Umorzyła? Ona? To musiał być bardzo przekonujący argument.” Pisarz unosi brew. „Kiedyś zapytam, co pan jej obiecał.”",
      "actions": [
        {
          "setFlag": "dlug_przekupki_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_nazwiska_spisane": {
      "speaker": "Pisarz Atrament",
      "text": "„Spisał pan nazwiska? Miasto odzyskało swoich zmarłych. Kto by pomyślał, że to takie kłopotliwe.” Pisarz podpisuje bez słowa.",
      "actions": [
        {
          "setFlag": "cmentarz_bez_nazwisk_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_nazwiska_zatajone": {
      "speaker": "Pisarz Atrament",
      "text": "„Zataił pan? Cicho, ostrożnie, rozsądnie. Rzadkie połączenie w tej okolicy.” Pisarz zamyka księgę.",
      "actions": [
        {
          "setFlag": "cmentarz_bez_nazwisk_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_nazwiska_sprzedane": {
      "speaker": "Pisarz Atrament",
      "text": "„Sprzedał pan listę? Lubię pana, choć nie powinienem. Tylko niech pan pamięta, że ten, kto kupuje, rzadko bywa dobrym człowiekiem.” Pisarz podsuwa ci pieczątkę.",
      "actions": [
        {
          "setFlag": "cmentarz_bez_nazwisk_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_list_dostarczony": {
      "speaker": "Pisarz Atrament",
      "text": "„Dostarczył pan i nie przeczytał? Taka wstrzemięźliwość to najrzadsza cnota.” Pisarz stempluje z szacunkiem.",
      "actions": [
        {
          "setFlag": "list_dla_marszalka_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "biuro"
        }
      ]
    },
    "meld_stolica_list_przeczytany": {
      "speaker": "Pisarz Atrament",
      "text": "„Przeczytał pan? To dobrze, to źle, to… zależy, co tam było. Na wszelki wypadek niech pan nic nie mówi.” Pisarz zaciera ręce, jakby chciał je umyć.",
      "actions": [
        {
          "setFlag": "list_dla_marszalka_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_stolicy": 1
          }
        }
      ],
