    },
    "plotka_zle": {
      "speaker": "Kwatermistrz Dobrogost",
      "text": "„Kurier? Jaki kurier? Stoję tu od świtu i widzę same gęby, co nic nie kupują.” Prycha i wraca do liczenia. Z tego kamienia wody nie wyciśniesz.",
      "options": [
        {
          "text": "Dalej.",
