    "wydaj": {
      "speaker": "Smyk",
      "portrait": "portret_smyk",
      "text": "Strażnik wciska ci dziesięć groszy i idzie pod mur. Nikogo nie łapie. Staje obok chłopaka w czapce i zaczynają rozmawiać o rybach. Po chwili chłopak patrzy na ciebie ponad jego ramieniem. „To mój szwagier. Stoi tu dla każdego, kto do mnie idzie. Srebro niech pan zatrzyma, bo drożej już pan na tej ulicy nie sprzeda. Za drobne powiem panu to, co każdy wie. Reszty nie.”",
      "options": [
        {
          "id": "dalej",
          "text": "Trudno.",
          "goto": "end"
        }
      ],
      "actions": [
        {
          "setFlag": "smyk_proba_byla"
        },
        {
          "giveMoney": 10
        },
        {
          "setFlag": "smyk_wydal"
        }
      ]
    },
    "wydaj_interes": {
      "speaker": "Smyk",
      "portrait": "portret_smyk",
      "text": "Strażnik wciska ci dziesięć groszy i idzie pod mur. Nikogo nie łapie. Staje obok chłopaka w czapce i obaj się śmieją. Chłopak podchodzi, wcale niezdziwiony. „To mój szwagier. Wiedziałem, że pan to zrobi, pół ulicy wie, co pan robił na froncie. Prowokator by nie wziął, bo chciałby wyjść na porządnego. Pan sprzedaje każdego, ale przynajmniej wiadomo za ile. Z takim można robić interesy.”",
      "options": [
        {
          "id": "dalej",
          "text": "Więc robimy interesy.",
          "goto": "end"
        }
      ],
      "actions": [
        {
          "setFlag": "smyk_proba_byla"
        },
        {
          "giveMoney": 10
        },
        {
          "setFlag": "smyk_interes"
        }
      ]
    },
    "rep_dobra": {
      "speaker": "Smyk",
      "portrait": "portret_smyk",
      "text": "Smyk pierwszy raz patrzy ci prosto w oczy. „No tak. Furmani gadają, że był taki jeden, co nie zostawił ludzi na polu i nie wziął pieniędzy, choć mógł, a cesarscy mają na niego opis. Kiepski, ale buty się zgadzają. Taką bajkę opowie każdy, tyle że pan przed chwilą w niej wystąpił.”",
      "options": [
        {
          "id": "dalej",
          "text": "To pogadajmy.",
          "goto": "end"
        }
      ]
    },
    "rep_zla": {
      "speaker": "Smyk",
      "portrait": "portret_smyk",
      "text": "„Słyszałem. Wiem, co pan robił na froncie, pół ulicy wie. Szwagra mi pan dziś nie sprzedał, więc albo się pan zmienił, albo czeka na lepszą cenę. Jedno i drugie da się przeżyć, byle wiedzieć które.”",
      "options": [
        {
          "id": "dalej",
          "text": "To pogadajmy.",
          "goto": "end"
        }
      ]
    },
    "rep_nic": {
      "speaker": "Smyk",
      "portrait": "portret_smyk",
      "text": "„Cesarscy szukają połowy miasta. Drugiej połowy nie muszą, bo sama przychodzi.” Smyk drapie się pod czapką. „O panu nic nie słyszałem, a to może być dobrze. Na razie wierzę szwagrowi. Szwagier się rzadko myli, chociaż ryby kupuje fatalnie.”",
      "options": [
        {
          "id": "dalej",
          "text": "To pogadajmy.",
          "goto": "end"
        }
      ]
    }
  }
