    "bogdan_miecz": {
      "speaker": "Kowal Bogdan",
      "text": "Bogdan przyszedł tu z Głuszca na piechotę, bo wstyd mu było czekać na wóz. Trzyma odłamek w obcęgach i patrzy na niego jak na dłużnika. „Metal się nie zgadza z żelazem, ale się dogada.” Przez noc wali młotem, a nad ranem wręcza ci ostrze, które wygląda raczej jak niezbyt rozmowny sąsiad.",
      "options": [
        {
          "id": "dalej",
          "text": "Dzięki.",
          "goto": "end"
        }
      ],
      "actions": [
        {
          "takeItem": "odlamek_krateru"
        },
        {
          "giveItem": "ostrze_gwiazd_bogdana"
        },
        {
          "setFlag": "ostrze_odebrane"
        },
        {
          "setFlag": "ostrze_bogdana"
        }
      ]
    },
    "bogdan_wlocznie": {
      "speaker": "Kowal Bogdan",
      "text": "Bogdan przyszedł tu z Głuszca na piechotę, bo wstyd mu było czekać na wóz. Dzieli odłamek na dwa równe groty, jakby kroił chleb dla bliźniaków. „Dwie ręce, dwa żądła. Nie dawaj im się wadzić.” O świcie wręcza ci parę, która leży w dłoniach, jakby ją tam zostawiono.",
      "options": [
        {
          "id": "dalej",
          "text": "Dzięki.",
          "goto": "end"
        }
      ],
      "actions": [
        {
          "takeItem": "odlamek_krateru"
        },
        {
          "giveItem": "para_gwiazd_bogdana"
        },
        {
          "setFlag": "ostrze_odebrane"
        },
        {
          "setFlag": "ostrze_bogdana"
        }
      ]
    },
    "brygida_miecz": {
      "speaker": "Mechanik Brygida",
      "text": "Brygida kuje bez ceregieli i bez Bogdana, bo z Głuszca nikt nie przyszedł. Na własny rachunek i bez narzekania. Ostrze wychodzi krzywe, ale gwiezdne. „Nie podziękujesz, bo i tak nie będzie piękne”, mówi, wycierając ręce w fartuch.",
      "options": [
        {
          "id": "dalej",
          "text": "Dzięki.",
          "goto": "end"
        }
      ],
      "actions": [
        {
          "takeItem": "odlamek_krateru"
        },
        {
          "giveItem": "ostrze_gwiazd_surowe"
        },
        {
          "setFlag": "ostrze_odebrane"
        },
        {
          "setFlag": "ostrze_surowe"
        }
      ]
    },
    "brygida_wlocznie": {
      "speaker": "Mechanik Brygida",
      "text": "Brygida kuje bez Bogdana, na własny rachunek i w pośpiechu. Dwa nierówne groty z nieba, brzydkie jak grzech i tak samo skuteczne. „Kłuć będą. Ładne nie będą.” Pierwszy raz widzisz ją prawie uśmiechniętą.",
      "options": [
        {
          "id": "dalej",
          "text": "Dzięki.",
          "goto": "end"
        }
      ],
