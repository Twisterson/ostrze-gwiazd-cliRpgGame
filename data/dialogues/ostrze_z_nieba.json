    "po": {
      "speaker": "Kuźnia w Obserwatorium",
      "text": "Kuźnia stygnie. Ostrze waży mniej, niż się spodziewałeś. Do stolicy daleko, ale droga jest jedna.",
      "options": [
        {
          "id": "dalej",
          "text": "Idę.",
          "goto": "end"
        }
