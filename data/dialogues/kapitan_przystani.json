    "zlecenia": {
      "speaker": "Kapitan Wars",
      "text": "„Tablica wisi na nabrzeżu. Bierz, co ci pasuje. Po robocie przychodzisz do mnie, ja zapisuję w księdze, ktoś płaci. Księga jest jedyną rzeczą na wyspie, której nikt jeszcze nie spalił.”",
      "options": [
        {
          "id": "dalej",
          "text": "Rozumiem.",
          "goto": "powrot"
        }
      ]
    },
    "plotki": {
      "speaker": "Kapitan Wars",
      "text": "„Mówią, że na Łysej Skale coś świeci po nocach, ale tam nikt nie chodzi, bo łodzie wracają bez sterników. Mówią też, że w Domu z Czarnego Szkła, za stocznią, stoi ściana, która odpowiada, jeśli się jej przyłoży odpowiednie żelazo. W obozie hetmana, za wzgórzem nad zatoką, rzadko ktoś bywa bez zaproszenia. I że na północy leżą wraki całej floty, z której nikt nie pamięta, kto ją wysłał.”",
      "actions": [
        {
          "reveal": "dom_czarnego_szkla"
        },
        {
          "reveal": "wraki_floty"
        },
        {
          "reveal": "oboz_hetmana"
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Dzięki.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_proch_zatopiony": {
      "speaker": "Kapitan Wars",
      "text": "„Zatopił pan cały ładunek? Starszyzna portowa będzie płakać, a ryby kichać. Zapisane.”",
      "actions": [
        {
          "setFlag": "lodz_bez_zalogi_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_proch_kapitan": {
      "speaker": "Kapitan Wars",
      "text": "„Proch przekazany do arsenału portowego? Uczciwie. Hetman będzie miał czym strzelać, a pan czyste sumienie, i jedno z dwóch na pewno się przyda.”",
      "actions": [
        {
          "setFlag": "lodz_bez_zalogi_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_proch_ukryty": {
      "speaker": "Kapitan Wars",
      "text": "„Ukrył pan beczki? Gdzie, nie pytam. Ważne, że ktoś wie, gdzie są, a ktoś inny nie.”",
      "actions": [
        {
          "setFlag": "lodz_bez_zalogi_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_kuznia_stop": {
      "speaker": "Kapitan Wars",
      "text": "„Kowal przestał kuć rusznice? Hetman się wścieknie, ale kowale rzadko słuchają hetmana, kiedy mają ciężki młot.”",
      "actions": [
        {
          "setFlag": "kowal_i_rusznice_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_kuznia_dalej": {
      "speaker": "Kapitan Wars",
      "text": "„Kuje dalej? No tak. Kowal ma ręce, rusznice mają zamówienia, wojna ma apetyt. Zapisuję bez ocen.”",
      "actions": [
        {
          "setFlag": "kowal_i_rusznice_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_kuznia_sabotaz": {
      "speaker": "Kapitan Wars",
      "text": "„Wadliwe lufy? Zapamiętam, żeby nie stawać blisko strzelca, który dostał pańskie rusznice. Zapisane.”",
      "actions": [
        {
          "setFlag": "kowal_i_rusznice_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_wiesc_przekazana": {
      "speaker": "Kapitan Wars",
      "text": "„Przekazał pan wieść hetmanowi? Dobrze, że ktoś tu jeszcze mówi, co wie. Przyda się.”",
      "actions": [
        {
          "setFlag": "wiesci_z_ladu_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_wiesc_zatrzymana": {
      "speaker": "Kapitan Wars",
      "text": "„Zatrzymał pan wieść dla siebie? Rozsądnie albo nieładnie, zależy, od której strony się patrzy. Zapisane.”",
      "actions": [
        {
          "setFlag": "wiesci_z_ladu_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_przejscie_uzyte": {
      "speaker": "Kapitan Wars",
      "text": "„Poszedł pan przejściem Smyka? Dobrze. Chłopak jest jedynym człowiekiem na wyspie, który zna trzy wyjścia z każdego pokoju.”",
      "actions": [
        {
          "setFlag": "przejscie_smyka_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_przejscie_odrzucone": {
      "speaker": "Kapitan Wars",
      "text": "„Poszedł pan bramą? Odważnie albo głupio. W obozie hetmana to prawie to samo.”",
      "actions": [
        {
          "setFlag": "przejscie_smyka_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_rozpoznanie_zapis": {
      "speaker": "Kapitan Wars",
      "text": "„Rysunki Brygidy zostają? Dobrze. Rzeczy, których nie rozumiemy, zapisuje się przynajmniej po to, żeby po nas ktoś je zrozumiał.”",
      "actions": [
        {
          "setFlag": "rozpoznanie_urzadzenia_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    },
    "meld_jarnowo_rozpoznanie_zniszczone": {
      "speaker": "Kapitan Wars",
      "text": "„Spalił pan notatki? Rozsądnie. Rzeczy, których nikt nie rozumie, bywają najbezpieczniejsze, gdy ich nie ma.”",
      "actions": [
        {
          "setFlag": "rozpoznanie_urzadzenia_zameldowane"
        },
        {
          "addVar": {
            "zlecenia_jarnowa": 1
          }
        }
      ],
      "options": [
        {
          "id": "dalej",
          "text": "Do usług.",
          "goto": "powrot"
        }
      ]
    }
  }
}
